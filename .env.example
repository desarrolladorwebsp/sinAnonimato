# Clave de Resend. Créala en https://resend.com/api-keys
# El dominio sinanonimato.cl debe estar verificado en Resend.
# En local va en .env.local. En el servidor, en las variables de cPanel.
RESEND_API_KEY=re_pon_aqui_la_clave

# Opcional. Si se omite, los correos salen desde contacto@sinanonimato.cl
# RESEND_FROM=Sin Anonimato <contacto@sinanonimato.cl>

# Autorizaciones: requieren Next.js ejecutándose con Node.js (sin STATIC_EXPORT=1).
# Usar una base PostgreSQL propia del entorno; nunca reutilizar producción en pruebas.
DATABASE_URL=
# Neon: conexión directa para migraciones; la aplicación conserva DATABASE_URL agrupada.
DATABASE_URL_UNPOOLED=
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Generar secretos independientes. No compartirlos ni confirmarlos en Git.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
AUTHORIZATION_ENCRYPTION_KEY=
AUTHORIZATION_CRON_SECRET=
# Correos separados por comas. Administradores publican documentos y gestionan conservación.
AUTHORIZATION_ADMIN_EMAILS=
# Producción puede consultar, descargar, invitar y reenviar, sin publicar ni eliminar.
AUTHORIZATION_PRODUCTION_EMAILS=
# Destinatario de avisos de autorizaciones completas (una dirección).
PRODUCTION_EMAIL=
# Definir con el responsable. Usar días o el modo expreso indefinite, siempre con política.
# AUTHORIZATION_RETENTION_MODE=indefinite
AUTHORIZATION_RETENTION_DAYS=
AUTHORIZATION_RETENTION_POLICY=
# Webhook dedicado; eventos enviados, entregados, rebotados, fallidos y suprimidos.
RESEND_AUTHORIZATION_WEBHOOK_SECRET=
